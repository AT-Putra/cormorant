# Copy to .env on each host: `cp .env.example .env`, then edit.
#
# Nothing secret belongs in this file, and nothing secret needs to. The Fernet
# key, the SQLite DB and the encrypted cookie blobs all live in the named
# volumes on the host that runs the app — never in the image, never in git.
# That is what lets this repository be public.

# Quiet-hours correctness depends on this being the operator's real zone.
TZ=UTC

# Which published image to run. CI tags every push to main as both :latest and
# :<full-git-sha>. Pin a sha here to roll back, or do it for one run without
# editing anything: `TAG=<sha> docker compose up -d`.
TAG=latest
